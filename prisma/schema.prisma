datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String              @id @default(uuid())
  name                      String
  phone                     String              @unique
  email                     String?
  password                  String
  securityPin               String              @default("1234")
  referralCode              String              @unique
  referredBy                String?
  referralTier              Int                 @default(1)
  balance                   Float               @default(0)
  investedCapital           Float               @default(0)
  totalWithdrawn            Float               @default(0)
  totalEarnedProfit         Float               @default(0)
  referralEarnings          Float               @default(0)
  unclaimedReferralEarnings Float               @default(0)
  is2faEnabled              Boolean             @default(false)
  dailyStreak               Int                 @default(1)
  lastCheckInDate           String?
  notificationsCount        Int                 @default(0)
  avatar                    String              @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80")
  joinedDate                String
  isVerified                Boolean             @default(true)
  isAdmin                   Boolean             @default(false)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  investments               ActiveInvestment[]
  transactions              Transaction[]
  paymentAccounts           PaymentAccount[]

  @@index([phone])
  @@index([referralCode])
  @@index([referredBy])
}

model ActiveInvestment {
  id                  String   @id @default(uuid())
  userId              String
  planId              String
  planName            String
  planCategory        String
  accentColor         String
  investedAmount      Float
  dailyProfitPercent  Float
  dailyProfitAmount   Float
  hourlyProfitAmount  Float
  totalExpectedReturn Float
  earnedSoFar         Float    @default(0)
  durationDays        Int
  daysRemaining       Int
  hoursRemaining      Int      @default(24)
  startDate           String
  endDate             String
  nextPayoutTime      String   @default("00:00 AM (Daily)")
  status              String   @default("active")
  lastClaimTimestamp  BigInt   @default(0)
  unclaimedProfit     Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String?
  userName      String?
  userPhone     String?
  type          String
  amount        Float
  fee           Float    @default(0)
  netAmount     Float
  status        String   @default("pending")
  gateway       String?
  accountTitle  String?
  accountNumber String?
  bankName      String?
  senderPhone   String?
  senderTitle   String?
  referenceCode String
  timestamp     String
  notes         String?
  planName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([referenceCode])
}

model PaymentAccount {
  id            String   @id @default(uuid())
  userId        String
  gateway       String
  accountTitle  String
  accountNumber String
  bankName      String?
  isDefault     Boolean  @default(false)
  addedDate     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestmentPlan {
  id                  String   @id
  name                String
  category            String
  icon                String
  badge               String?
  minAmount           Float
  maxAmount           Float
  fixedAmount         Float?
  dailyProfitPercent  Float
  dailyProfitAmount   Float
  durationDays        Int
  totalRoiPercent     Float
  totalReturnAmount   Float
  payoutFrequency     String   @default("daily")
  capitalReturnPolicy String   @default("Capital returned on maturity")
  description         String
  highlights          String[]
  popular             Boolean  @default(false)
  accentColor         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DepositChannel {
  id             String   @id @default(uuid())
  gateway        String   @unique
  accountTitle   String
  accountNumber  String
  bankName       String?
  branchCode     String?
  instructions   String
  minDeposit     Float
  maxDeposit     Float
  processingTime String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
